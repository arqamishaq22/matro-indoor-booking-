# --- Server -----------------------------------------------------------------
PORT=3001
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# XAMPP MySQL (default XAMPP root account has no password).
# If you set a MySQL password, add it after "root:" in this URL.
DATABASE_URL="mysql://root:@127.0.0.1:3306/indoor_booking"

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"

# --- Security ---------------------------------------------------------------
# JWT secret - REQUIRED for authentication (Phase C)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Timezone ---------------------------------------------------------------
# Lahore / Pakistan Standard Time UTC+5
TZ=Asia/Karachi
