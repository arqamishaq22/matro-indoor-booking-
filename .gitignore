# ── Dependencies ──────────────────────────────────────────
node_modules/
server/node_modules/

# ── Build output ───────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Environment files — never commit secrets ───────────────
.env
.env.*
!.env.example
server/.env
# Keep the example files — they document required variables
!server/.env.example

# ── Database files — never commit ──────────────────────────
server/prisma/*.db
server/prisma/*.db-journal
server/prisma/*.db-shm
server/prisma/*.db-wal
# Keep the nested prisma/prisma folder path used in this project
server/prisma/prisma/

# ── Prisma generated client — machine-specific binaries ────
# Regenerate with: npx prisma generate
server/node_modules/.prisma/
server/node_modules/@prisma/client/

# ── Editor / OS ────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Vite cache ─────────────────────────────────────────────
.vite/

# ── Leftover scaffold / releases ───────────────────────────
Matro/
*.zip
*.tar.gz
